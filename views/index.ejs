<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>Movies app</title>
  <link rel="shortcut icon" href="favicon.ico">
  <link rel="stylesheet" href="font-awesome.min.css">
  <link rel="stylesheet" href="styles.css">
</head>

<body>
  <h1>Movies</h1>
  <h2>What is your favorite movie?</h2>

  <form action="/movies" method="POST">
    <input type="text" placeholder="Movie Name" name="name" required>
    <input type="text" placeholder="Release Year" name="year" required>
    <button type="submit">Add Movie</button>
  </form>

  <hr>

  <h2>Search Movie Year</h2>
  <input type="text" id="movieName" placeholder="Enter movie name and press Enter">
  <p id="movieYear"></p>

  <hr>

  <h2>All Movies in Database</h2>
  <ul class="movies">
    <% for (let i=0; i < movies.length; i++) { %>
      <li>
        <strong>
          <%= movies[i].name %>
        </strong> - <%= movies[i].year %>

          <button class="edit" data-name="<%= movies[i].name %>" data-year="<%= movies[i].year %>">
            Edit
          </button>

          <button class="delete" data-name="<%= movies[i].name %>">
            Delete
          </button>
      </li>
      <% } %>
  </ul>

  <script src="/main.js"></script>
</body>

</html>